# Copy to .env on the server. Do not commit the real file.
POSTGRES_DB=carbot_db
POSTGRES_USER=carbot_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
ML_HOST_PATH=../carbot-machine-learning/machine_learning
API_PORT=8000

# Required application secrets. Generate distinct values for production.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
PRIVACY_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
META_APP_SECRET=REPLACE_WITH_META_APP_SECRET

# Configure provider credentials and callback values only in the server .env.
GEMINI_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
