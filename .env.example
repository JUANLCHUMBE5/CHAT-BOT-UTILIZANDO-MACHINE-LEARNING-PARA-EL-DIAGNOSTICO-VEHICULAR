# CONFIGURACION DE ENTORNO
ENVIRONMENT=production
PYTHONUTF8=1

# METADATOS Y CREDENCIALES DE WHATSAPP (META CLOUD API)
META_ACCESS_TOKEN=tu_meta_access_token_aqui
META_PHONE_NUMBER_ID=tu_phone_number_id_aqui
META_APP_SECRET=tu_app_secret_aqui
META_VERIFY_TOKEN=tu_verify_token_aqui

# GEMINI API (GOOGLE AI STUDIO)
GEMINI_API_KEY=tu_gemini_api_key_aqui

# DOMINIO / HOST PUBLICO (TUNEL O DOMINIO REAL)
NGROK_DOMAIN=
TRUSTED_HOSTS=localhost,127.0.0.1,api.tudominio.com

# BASE DE DATOS POSTGRESQL
DATABASE_ENABLED=true
DATABASE_REQUIRED=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=carbot_db
POSTGRES_USER=carbot_app
POSTGRES_PASSWORD=tu_contraseña_segura_aqui

# SEGURIDAD Y JWT
JWT_SECRET_KEY=genera_una_clave_segura_de_al_menos_32_caracteres
PRIVACY_SECRET_KEY=genera_otra_clave_segura_de_al_menos_32_caracteres
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost,https://tudominio.com

# MACHINE LEARNING Y RAG
ML_ROOT=/app/machine_learning
MODEL_VERSION=C1_FASE10_FINAL
CARBOT_RAG_VERSION=candidate_v1
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
AUDIO_ENABLED=false
