# CarBot - plantilla sin credenciales reales
ENVIRONMENT=development
DEBUG=false
PORT=8000
CORS_ALLOWED_ORIGINS="http://localhost:5173"
TRUSTED_HOSTS="localhost,127.0.0.1,tu-subdominio.ngrok-free.dev"
# Mantener false en producción; los detalles internos deben ir a observabilidad privada.
EXPOSE_HEALTH_DETAILS=false
# Se detecta automáticamente; defínalo solo en despliegues con otra ruta.
ML_ROOT=""

# PostgreSQL local / Amazon RDS
DATABASE_ENABLED=false
DATABASE_REQUIRED=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=carbot_db
POSTGRES_USER=carbot_app
POSTGRES_PASSWORD="REEMPLAZAR_CON_CLAVE_SEGURA"
DATABASE_URL=""
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Base exclusiva para pruebas; nunca use carbot_db aqui.
TEST_DATABASE_URL="postgresql+asyncpg://carbot_app:CLAVE@127.0.0.1:5433/carbot_test"
# Solo se usa temporalmente para crear carbot_test; no lo guarde en Git.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=""

# WhatsApp Meta Cloud API
META_ACCESS_TOKEN="REEMPLAZAR_TOKEN_META"
META_PHONE_NUMBER_ID="REEMPLAZAR_PHONE_NUMBER_ID"
META_GRAPH_API_VERSION="v25.0"
META_MESSAGE_PRICE_USD=0.0
META_VERIFY_TOKEN="REEMPLAZAR_TOKEN_VERIFICACION"
META_APP_SECRET="REEMPLAZAR_APP_SECRET"

# Twilio WhatsApp opcional
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_MESSAGE_PRICE_USD=0.005

# Privacidad
PRIVACY_SECRET_KEY="REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES"

# AWS Secrets Manager opcional
AWS_SECRETS_ENABLED=false
AWS_SECRETS_NAME=""
AWS_REGION="us-east-1"

# Gemini
GEMINI_API_KEY="REEMPLAZAR_API_KEY_GEMINI"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_USE_FREE_TIER=true
GEMINI_INPUT_PRICE_PER_MILLION=0.30
GEMINI_OUTPUT_PRICE_PER_MILLION=2.50
GEMINI_MAX_REQUESTS_PER_MINUTE=12
GEMINI_MAX_REQUESTS_PER_DAY=18

# RAG: provisional hasta calibrarlo con un conjunto de recuperacion etiquetado.
RAG_MIN_SIMILARITY=0.25

# Frontend Web Dashboard
VITE_API_BASE_URL="http://localhost:8000/api/v1"

# Ngrok local
NGROK_DOMAIN="tu-subdominio.ngrok-free.dev"
PYTHONUTF8="1"

# Seguridad de API
JWT_SECRET_KEY="REEMPLAZAR_CON_SECRETO_ALEATORIO_DE_32_O_MAS_CARACTERES"
# Fallback local únicamente cuando PostgreSQL está desactivado
LOCAL_AUTH_USERNAME="REEMPLAZAR_ADMIN"
LOCAL_AUTH_PASSWORD="REEMPLAZAR_PASSWORD_SEGURO"
JWT_ISSUER="carbot-api"
JWT_AUDIENCE="carbot-clients"
RATE_LIMIT_STORAGE_URI="memory://"
REFRESH_COOKIE_NAME="carbot_refresh"
REFRESH_COOKIE_SAMESITE="lax"
# Compatibilidad local; en producción debe ser false para no exponer el refresh token a JavaScript.
LEGACY_REFRESH_TOKEN_BODY=false
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RAG_CONTEXT_MAX_CHARS=12000
GEMINI_OUTPUT_MAX_CHARS=8000
# SHA-256 individuales exigidos en producción antes de deserializar artefactos joblib.
MODEL_PKL_SHA256=""
VECTORIZER_PKL_SHA256=""

# Audio y limites
AUDIO_ENABLED=false
AUDIO_MAX_BYTES=10485760
WEBHOOK_MAX_BODY_BYTES=1048576
USER_TEXT_MAX_CHARS=500
DATA_RETENTION_DAYS=180

# Cola durable y worker independiente
QUEUE_EMBEDDED_WORKER=false
QUEUE_POLL_INTERVAL_MS=500
QUEUE_MAX_PENDING=1000
QUEUE_MAX_PENDING_PER_TALLER=200
QUEUE_JOB_MAX_ATTEMPTS=4
QUEUE_JOB_LOCK_SECONDS=180
QUEUE_PAYLOAD_RETENTION_DAYS=7

MODEL_VERSION="2.2.0-external-audited"
MODEL_ALGORITHM="Linear SVM calibrado + TF-IDF"
MODEL_ARTIFACT_URL=""
MODEL_ARTIFACT_SHA256=""

# Pruebas de carga con Locust
LOCUST_AUTH_USERNAME=""
LOCUST_AUTH_PASSWORD=""
