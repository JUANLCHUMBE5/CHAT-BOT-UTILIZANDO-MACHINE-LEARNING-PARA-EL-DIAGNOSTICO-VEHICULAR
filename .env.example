# ========================================
# CarBot - Diagnóstico Vehicular con ML
# Variables de Entorno (Configuración)
# ========================================

# Entorno: development | production
ENVIRONMENT=development
PORT=8000

# --- PostgreSQL local / Amazon RDS ---
DATABASE_ENABLED=false
DATABASE_REQUIRED=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=carbot_db
POSTGRES_USER=carbot_app
POSTGRES_PASSWORD="REEMPLAZAR_CON_UNA_CLAVE_SEGURA"
# Alternativa: si se define DATABASE_URL, tiene prioridad sobre los campos anteriores.
# DATABASE_URL="postgresql+asyncpg://carbot_app:CLAVE@127.0.0.1:5432/carbot_db"
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Pruebas de integración: usar siempre otra base, por ejemplo carbot_test.
TEST_DATABASE_URL="postgresql+asyncpg://carbot_app:CLAVE@127.0.0.1:5432/carbot_test"
ALLOW_UNSAFE_TEST_DATABASE=false

# --- WhatsApp Meta Cloud API ---
TOKEN_WHATSAPP="TU_TOKEN_PERMANENTE_DE_META_CLOUD_API"
TELEFONO_ID="TU_TELEFONO_ID_DE_META"
META_GRAPH_API_VERSION="v23.0"
META_MESSAGE_PRICE_USD=0.0
VERIFY_TOKEN="MI_TOKEN_DE_VERIFICACION_SEC_123"
META_VERIFY_TOKEN="MI_TOKEN_DE_VERIFICACION_SEC_123"
META_APP_SECRET="TU_APP_SECRET_DE_META_PARA_FIRMA_HMAC"

# --- Twilio WhatsApp Integration ---
TWILIO_ACCOUNT_SID="TU_TWILIO_ACCOUNT_SID"
TWILIO_AUTH_TOKEN="TU_TWILIO_AUTH_TOKEN"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_MESSAGE_PRICE_USD=0.005

# --- Privacidad y Pseudonimización HMAC ---
PRIVACY_SECRET_KEY="clave_secreta_para_pseudonimizar_placas_y_telefonos_hmac_2026"

# --- Gemini API (LLM) ---
GEMINI_API_KEY="TU_API_KEY_DE_GOOGLE_GEMINI"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_USE_FREE_TIER=true
GEMINI_INPUT_PRICE_PER_MILLION=0.30
GEMINI_OUTPUT_PRICE_PER_MILLION=2.50
GEMINI_MAX_REQUESTS_PER_MINUTE=12
GEMINI_MAX_REQUESTS_PER_DAY=18

# --- Ngrok Tunnel (Dominio Estático) ---
NGROK_DOMAIN="tu-subdominio.ngrok-free.dev"

# --- Codificación UTF-8 para Windows ---
PYTHONUTF8="1"

# --- Credenciales de Autenticación JWT ---
# En PRODUCCIÓN, estas claves DEBEN cambiarse o el servidor rehusará iniciar.
JWT_SECRET_KEY="genera_una_clave_secreta_de_al_menos_32_caracteres_aqui"
AUTH_USERNAME="usuario_administrador_seguro"
AUTH_PASSWORD="password_altamente_seguro_2026"
JWT_ISSUER="carbot-api"
JWT_AUDIENCE="carbot-clients"
RATE_LIMIT_STORAGE_URI="memory://"

# --- Función de Audio (Comité de Ética) ---
HABILITAR_AUDIO="false"
AUDIO_MAX_BYTES=10485760
WEBHOOK_MAX_BODY_BYTES=1048576
USER_TEXT_MAX_CHARS=500
DATA_RETENTION_DAYS=180

# El modelo de 518 MB se obtiene desde almacenamiento de artefactos (S3/HTTPS), no desde Git.
MODEL_VERSION="2026-08-local"
MODEL_ARTIFACT_URL=""
MODEL_ARTIFACT_SHA256=""
